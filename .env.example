# Αντιγράψτε σε .env και συμπληρώστε. Το .env δεν ανεβαίνει στο git.
# Στο Hugging Face Space οι ίδιες τιμές δίνονται ως Secrets / Variables (Settings → Variables and secrets).

# Κλειδί του Claude API (console.anthropic.com). Χωρίς αυτό οι συνόψεις είναι απενεργοποιημένες.
ANTHROPIC_API_KEY=

# Μοντέλο για τις συνόψεις: claude-opus-5-5 (προεπιλογή) ή claude-haiku-5-5 (~40x φθηνότερο).
LLM_MODEL=claude-opus-5-5

# Μέγιστος αριθμός ΝΕΩΝ συνόψεων την ημέρα (οι αποθηκευμένες δεν μετράνε).
DAILY_SUMMARY_LIMIT=300

# Cloudflare Turnstile («δεν είμαι ρομπότ» στον διακόπτη LLM). Κενά = χωρίς επιβεβαίωση (μόνο τοπικά).
# Για τοπική δοκιμή του κουτιού: τα δοκιμαστικά κλειδιά του Cloudflare (επιτυγχάνουν πάντα)
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Κωδικός πρόσβασης (τουλάχιστον 12 χαρακτήρες). Κενό = χωρίς κωδικό (μόνο τοπικά).
ACCESS_CODE=

# Μόνο για την προετοιμασία δεδομένων από το Hugging Face (scripts/prepare_data.py).
HF_TOKEN=
